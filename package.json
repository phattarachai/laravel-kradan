{
  "name": "laravel-kradan-board",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Browser side of phattarachai/laravel-kradan: the board, the index page and the frame agent. Built into dist/ and committed.",
  "scripts": {
    "build": "node resources/board/build.mjs",
    "watch": "node resources/board/build.mjs --watch",
    "dev": "node --watch-path=resources/board/dev --watch-path=resources/views resources/board/dev/server.mjs",
    "test": "node --test \"resources/board/test/*.test.mjs\"",
    "sync:workbench": "node resources/board/sync.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "laravel-echo": "^2.1.0",
    "linkedom": "^0.18.9",
    "pusher-js": "^8.4.0"
  }
}
